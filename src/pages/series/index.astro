---
import Layout from "@layouts/Layout.astro";
import SeriesList from "@components/SeriesList.astro";

const baseUrl = import.meta.env.SITE ?? Astro.url.origin;
---

<Layout 
    title="Jaehee.dev"
    description="시리즈 목록 페이지입니다."
    url={baseUrl + Astro.url.pathname}
>
    <div class="content-container my-6 px-4">
        <div class="inline-flex items-center mb-4 border-b-2 border-accent">
            <span class="mr-2 h-3 w-3 shrink-0 bg-accent" aria-hidden="true"></span>
            <h1 class="font-bold text-xl">Series</h1>
        </div>

        <SeriesList />
    </div>
</Layout>
