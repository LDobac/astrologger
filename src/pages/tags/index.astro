---
import Layout from "@layouts/Layout.astro";
import TagList from "@components/TagList.astro";

const baseUrl = import.meta.env.SITE ?? Astro.url.origin;
---

<Layout 
    title="Jaehee.dev - Tags" 
    description="태그 목록 페이지입니다."
    url={baseUrl + Astro.url.pathname}
    >
    <div class="content-container my-6 px-4 space-y-12">
        <div>
            <div class="inline-flex items-center mb-4 border-b-2 border-accent">
                <span class="mr-2 h-3 w-3 shrink-0 bg-accent" aria-hidden="true"></span>
                <h1 class="font-bold text-xl">Tags</h1>
            </div>
    
            <TagList />
        </div>
    </div>
</Layout>
