---
import Layout from "@layouts/Layout.astro";
import PostList from "@components/PostList.astro";
import TagList from "@components/TagList.astro";
import { GetPosts } from "@utils/GetPosts";
import SeriesList from "@components/SeriesList.astro";
import RSSFeed from "@components/RSSFeed.astro";

const posts = (await GetPosts(true)).slice(0, 8);
---

<Layout>
    <div class="content-container-wide my-6 px-4 space-y-12">
        <h1 class="sr-only">Jaehee.dev — 개발 블로그</h1>

        <div>
            <div class="flex items-center justify-between">
                <div class="inline-flex items-center mb-4 border-b-2 border-accent">
                    <span class="mr-2 h-3 w-3 shrink-0 bg-accent" aria-hidden="true"></span>
                    <h2 class="font-bold text-xl">Recent Posts</h2>
                </div>

                <RSSFeed />
            </div>

            <PostList posts={posts} />
        </div>

        <div>
            <div class="inline-flex items-center mb-4 border-b-2 border-accent">
                <span class="mr-2 h-3 w-3 shrink-0 bg-accent" aria-hidden="true"></span>
                <h2 class="font-bold text-xl">Tags</h2>
            </div>

            <TagList />
        </div>

        <div>
            <div class="inline-flex items-center mb-4 border-b-2 border-accent">
                <span class="mr-2 h-3 w-3 shrink-0 bg-accent" aria-hidden="true"></span>
                <h2 class="font-bold text-xl">Series</h2>
            </div>

            <SeriesList />
        </div>
    </div>
</Layout>
