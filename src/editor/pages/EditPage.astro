---
import EditorShell from "../components/EditorShell.astro";

const field = "w-full rounded border border-line bg-canvas px-2 py-1 text-sm";
const label = "mb-0.5 block text-xs font-bold text-fg-muted";
const button = "rounded border border-line px-3 py-1 text-sm hover:bg-canvas-subtle disabled:opacity-50";
const tool = "rounded px-2 py-1 text-sm hover:bg-canvas-subtle";
---

<EditorShell title="글 편집 · Editor" bodyClass="flex h-dvh flex-col overflow-hidden">
    <header class="flex items-center gap-3 border-b border-line px-4 py-2">
        <a href="/__editor" class="shrink-0 text-sm text-fg-muted hover:text-accent">← 글 목록</a>
        <span id="doc-kind" class="shrink-0 rounded border border-line px-1.5 text-xs text-fg-muted"></span>
        <span id="doc-source" class="truncate text-xs text-fg-muted"></span>
        <span id="status" class="ml-auto shrink-0 text-xs text-fg-muted"></span>
        <button id="btn-meta" class={button}>메타데이터</button>
        <button id="btn-delete" class={`${button} hidden hover:border-red-500 hover:text-red-500`}>글 삭제</button>
        <button id="btn-discard" class={button}>폐기</button>
        <button id="btn-save" class={button} title="Ctrl+S">임시 저장</button>
        <button id="btn-publish" class="rounded bg-accent px-3 py-1 text-sm font-bold text-canvas hover:opacity-90 disabled:opacity-50">배포</button>
    </header>

    <section id="meta" class="grid grid-cols-1 gap-3 border-b border-line bg-canvas-subtle px-4 py-3 md:grid-cols-6">
        <div class="md:col-span-4">
            <label class={label} for="m-title">제목 *</label>
            <input id="m-title" class={field} autocomplete="off" />
            <p id="m-slug" class="mt-0.5 text-xs text-fg-muted"></p>
        </div>
        <div>
            <label class={label} for="m-date">작성일 *</label>
            <input id="m-date" type="datetime-local" step="1" class={field} />
        </div>
        <div>
            <label class={label} for="m-edit">수정일</label>
            <input id="m-edit" type="datetime-local" step="1" class={field} />
        </div>
        <div class="md:col-span-6">
            <label class={label} for="m-desc">설명</label>
            <textarea id="m-desc" rows="2" class={field}></textarea>
        </div>
        <div class="md:col-span-2">
            <label class={label} for="m-series">시리즈 (없거나 1개)</label>
            <input id="m-series" list="series-list" class={field} placeholder="선택 또는 새로 입력" autocomplete="off" />
            <datalist id="series-list"></datalist>
        </div>
        <div class="md:col-span-4">
            <label class={label} for="m-tag-input">태그</label>
            <div id="m-tags" class="flex min-h-[30px] flex-wrap items-center gap-1.5 rounded border border-line bg-canvas px-2 py-1">
                <input id="m-tag-input" list="tag-list" class="min-w-[8rem] flex-1 bg-transparent text-sm outline-none" placeholder="선택 또는 입력 후 Enter" autocomplete="off" />
            </div>
            <datalist id="tag-list"></datalist>
        </div>
        <div class="md:col-span-3">
            <label class={label} for="m-og">OG 이미지 (첨부 중 선택)</label>
            <select id="m-og" class={field}></select>
        </div>
        <div class="md:col-span-3">
            <label class={label} for="m-og-alt">OG 이미지 설명(alt)</label>
            <input id="m-og-alt" class={field} />
        </div>
    </section>

    <div id="toolbar" class="flex flex-wrap items-center gap-1 border-b border-line px-2 py-1">
        <button class={`${tool} font-bold`} data-cmd="bold" title="굵게 (Ctrl+B)">B</button>
        <button class={`${tool} italic`} data-cmd="italic" title="기울임 (Ctrl+I)">I</button>
        <button class={`${tool} line-through`} data-cmd="strike" title="취소선 (Ctrl+Shift+X)">S</button>
        <button class={`${tool} font-mono`} data-cmd="code" title="인라인 코드 (Ctrl+`)">`</button>
        <span class="mx-1 h-5 border-l border-line"></span>
        <button class={tool} data-cmd="h2" title="제목 2 (Ctrl+Alt+2)">H2</button>
        <button class={tool} data-cmd="h3" title="제목 3 (Ctrl+Alt+3)">H3</button>
        <button class={tool} data-cmd="h4" title="제목 4 (Ctrl+Alt+4)">H4</button>
        <span class="mx-1 h-5 border-l border-line"></span>
        <button class={tool} data-cmd="link" title="링크 (Ctrl+K)">링크</button>
        <button class={tool} data-cmd="post-link" title="다른 게시글 링크 (Ctrl+Alt+K)">게시글 링크</button>
        <button class={tool} data-cmd="image" title="이미지 첨부 (Ctrl+Alt+I) · 붙여넣기/드래그 가능">이미지</button>
        <button class={tool} data-cmd="codeblock" title="코드 블록 (Ctrl+Alt+C)">코드 블록</button>
    </div>

    <main class="grid min-h-0 flex-1 grid-cols-2">
        <div id="editor" class="min-h-0 overflow-hidden border-r border-line"></div>
        <iframe id="preview" src="/__editor/preview" title="미리보기" class="h-full w-full"></iframe>
    </main>

    <input id="file-input" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,image/avif" multiple hidden />

    <dialog id="link-dialog" class="m-auto w-[32rem] max-w-[90vw] rounded-lg border border-line bg-canvas p-0 text-fg backdrop:bg-black/40">
        <div class="border-b border-line p-3">
            <input id="link-search" class={field} placeholder="게시글 제목 검색" autocomplete="off" />
        </div>
        <ul id="link-results" class="max-h-[50vh] overflow-y-auto p-1 text-sm"></ul>
    </dialog>

    <dialog id="publish-dialog" class="m-auto w-[34rem] max-w-[90vw] rounded-lg border border-line bg-canvas p-5 text-fg backdrop:bg-black/40">
        <form id="publish-form" method="dialog" class="space-y-4">
            <h2 class="text-lg font-bold">배포</h2>
            <div id="pub-new" class="space-y-3">
                <div>
                    <label class={label} for="pub-tree">트리 (폴더 경로, 비우면 루트)</label>
                    <input id="pub-tree" list="tree-list" class={field} placeholder="예: leet_code" autocomplete="off" />
                    <datalist id="tree-list"></datalist>
                </div>
                <div>
                    <label class={label} for="pub-folder">게시글 폴더 이름</label>
                    <input id="pub-folder" class={field} autocomplete="off" />
                </div>
            </div>
            <div id="pub-edit" class="space-y-3">
                <label class="flex items-center gap-2 text-sm">
                    <input id="pub-touch" type="checkbox" checked />
                    수정일을 현재 시각으로 갱신
                </label>
            </div>
            <p class="text-sm">저장 위치: <code id="pub-path" class="text-accent"></code></p>
            <p class="text-sm">URL: <code id="pub-url"></code></p>
            <p id="pub-warn" class="hidden rounded border border-yellow-500 bg-yellow-500/10 px-3 py-2 text-sm"></p>
            <p id="pub-error" class="hidden rounded border border-red-500 bg-red-500/10 px-3 py-2 text-sm text-red-600"></p>
            <div class="flex justify-end gap-2">
                <button type="button" id="pub-cancel" class={button}>취소</button>
                <button type="submit" id="pub-submit" class="rounded bg-accent px-3 py-1 text-sm font-bold text-canvas hover:opacity-90 disabled:opacity-50">배포</button>
            </div>
        </form>
    </dialog>

    <div id="toast" class="pointer-events-none fixed bottom-4 left-1/2 hidden -translate-x-1/2 rounded-lg bg-fg px-4 py-2 text-sm text-canvas shadow-lg"></div>
</EditorShell>

<script>
    import "../client/edit";
</script>
