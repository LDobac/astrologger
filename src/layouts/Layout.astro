---
import "@styles/global.css";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import {DEFAULT_OG_IMG_SIZE} from "@utils/Constants";
import { ClientRouter } from 'astro:transitions';

export interface OgPropImg {
    url: string;
    type?: string;
    width?: number;
    height?: number;
    alt?: string;
}

export interface OgProp {
    img?: OgPropImg 
}

interface Props {
	title?: string;
    author?: string;
    description?: string;
    url?: string;
    og?: OgProp
}

const baseUrl = import.meta.env.SITE ?? Astro.url.origin;
const defaultOgOpts: OgProp = {
    img: {
        url: baseUrl + "/blog_og_image.png",
        width: DEFAULT_OG_IMG_SIZE.width,
        height: DEFAULT_OG_IMG_SIZE.height,
        type: "image/png",
        alt: "Main image of jaeehee.dev"
    },
}
 

const { 
    title = "Jaehee.dev",
    author = "jaehee",
    description = "지식보단 삽질의 요람입니다.",
    url = baseUrl,
    og =  defaultOgOpts
} = Astro.props;

---

<!doctype html>

<html lang="ko">
	<head>
        <!-- 첫 페인트 전에 테마를 확정해야 다크모드에서 흰 화면이 번쩍이지 않는다. -->
        <script is:inline>
            (function () {
                function setTheme(theme) {
                    document.documentElement.classList.toggle("dark", theme === "dark");
                    document.documentElement.style.colorScheme = theme;
                }

                function applyTheme() {
                    // 저장값이 없으면 OS 설정을 따른다. 토글하기 전까지는 저장하지 않으므로
                    // 사용자가 OS 테마를 바꾸면 그대로 따라간다.
                    const stored = localStorage.getItem("theme");

                    setTheme(
                        stored ??
                            (window.matchMedia("(prefers-color-scheme: dark)").matches
                                ? "dark"
                                : "light"),
                    );
                }

                applyTheme();

                // ClientRouter는 페이지 전환 시 <html> 속성을 통째로 교체하므로 테마를 다시 적용한다.
                document.addEventListener("astro:after-swap", applyTheme);

                // 토글 버튼은 페이지 전환마다 새 엘리먼트로 교체되므로 document에 위임한다.
                // 이렇게 하면 리스너를 한 번만 등록해도 되고 중복 바인딩이 발생하지 않는다.
                document.addEventListener("click", function (event) {
                    if (!(event.target instanceof Element)) return;
                    if (!event.target.closest("#theme-toggle")) return;

                    const theme = document.documentElement.classList.contains("dark")
                        ? "light"
                        : "dark";

                    setTheme(theme);
                    localStorage.setItem("theme", theme);
                });
            })();
        </script>

        <ClientRouter />

        <link rel="sitemap" href="/sitemap-index.xml"/>
        <link rel="canonical" href={url}/>
        <link rel="alternate" type="application/rss+xml" title="Jaehee.dev" href="/rss.xml"/>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- DNS Prefetch & Preconnect -->
        <link rel="dns-prefetch" href="https://www.googletagmanager.com">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap">

		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">

		<meta name="generator" content={Astro.generator} />

        <meta name="description" content={description}>
        <meta name="author" content={author}>

        <meta property="og:url" content={url}>
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Jaehee.dev">
        <meta property="og:locale" content="ko_KR">

        {!!og && (
            <Fragment>
                <meta property="og:title" content={title}>
                <meta property="og:description" content={description}>
            </Fragment>
        )}

        {og?.img &&
            <meta property="og:image" content={og.img.url}>
        }
        {og?.img?.alt && <meta property="og:image:alt" content={og.img.alt}>}
        {og?.img?.type && <meta property="og:image:type" content={og.img.type}>}
        {og?.img?.width && <meta property="og:image:width" content={og.img.width.toString()}>}
        {og?.img?.height && <meta property="og:image:height" content={og.img.height.toString()}>}

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content={title}>
        <meta name="twitter:description" content={description}>
        {og?.img && <meta name="twitter:image" content={og.img.url}>}
        {og?.img?.alt && <meta name="twitter:image:alt" content={og.img.alt}>}

        <!-- Google tag (gtag.js) -->
        {import.meta.env.PROD && (
            <Fragment>
                <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BLG37NTK4J"></script>
                <script is:inline>
                    // @ts-expect-error
                    window.dataLayer = window.dataLayer || [];
                    // @ts-expect-error
                    function gtag(){dataLayer.push(arguments);}
                    // @ts-expect-error
                    gtag('js', new Date());
                    // @ts-expect-error
                    gtag('config', 'G-BLG37NTK4J');
                </script>
            </Fragment>
        )}

        <!-- Naver Search Advisor -->
        {import.meta.env.PROD && (
            <meta name="naver-site-verification" content="6d6d37b7cb8c33fa22601afa3a994e0526b4a43f" />
        )}

        <slot name="extra-head" />

		<title>{title}</title>
	</head>
    <body class="flex min-h-dvh w-full flex-col bg-canvas text-fg">
        <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-canvas">본문 바로가기</a>
        <Header />
        <main id="main" class="flex-1">
            <slot />
        </main>
        <Footer />
	</body>
</html>
