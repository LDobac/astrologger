---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import {DEFAULT_OG_IMG_SIZE} from "@utils/Constants";
import { ClientRouter } from 'astro:transitions';

export interface OgPropImg {
    url: string;
    type?: string;
    width?: number;
    height?: number;
    alt?: string;
}

export interface OgProp {
    img?: OgPropImg 
}

interface Props {
	title?: string;
    author?: string;
    description?: string;
    url?: string;
    og?: OgProp
}

const baseUrl = import.meta.env.SITE ?? Astro.url.origin;
const defaultOgOpts: OgProp = {
    img: {
        url: baseUrl + "/blog_og_image.png",
        width: DEFAULT_OG_IMG_SIZE.width,
        height: DEFAULT_OG_IMG_SIZE.height,
        type: "image/png",
        alt: "Main image of jaeehee.dev"
    },
}
 

const { 
    title = "Jaehee.dev",
    author = "jaehee",
    description = "지식보단 삽질의 요람입니다.",
    url = baseUrl,
    og =  defaultOgOpts
} = Astro.props;

---

<!doctype html>

<html lang="ko">
	<head>
        <!-- 첫 페인트 전에 테마를 확정해야 다크모드에서 흰 화면이 번쩍이지 않는다. -->
        <script is:inline>
            (function () {
                function setTheme(theme) {
                    document.documentElement.classList.toggle("dark", theme === "dark");
                    document.documentElement.style.colorScheme = theme;
                }

                function applyTheme() {
                    // 저장값이 없으면 OS 설정을 따른다. 토글하기 전까지는 저장하지 않으므로
                    // 사용자가 OS 테마를 바꾸면 그대로 따라간다.
                    const stored = localStorage.getItem("theme");

                    setTheme(
                        stored ??
                            (window.matchMedia("(prefers-color-scheme: dark)").matches
                                ? "dark"
                                : "light"),
                    );
                }

                applyTheme();

                // ClientRouter는 페이지 전환 시 <html> 속성을 통째로 교체하므로 테마를 다시 적용한다.
                document.addEventListener("astro:after-swap", applyTheme);

                // 토글 버튼은 페이지 전환마다 새 엘리먼트로 교체되므로 document에 위임한다.
                // 이렇게 하면 리스너를 한 번만 등록해도 되고 중복 바인딩이 발생하지 않는다.
                document.addEventListener("click", function (event) {
                    if (!(event.target instanceof Element)) return;
                    if (!event.target.closest("#theme-toggle")) return;

                    const theme = document.documentElement.classList.contains("dark")
                        ? "light"
                        : "dark";

                    setTheme(theme);
                    localStorage.setItem("theme", theme);
                });
            })();
        </script>

        <ClientRouter />

        <link rel="sitemap" href="/sitemap-index.xml"/>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- DNS Prefetch & Preconnect -->
        <link rel="dns-prefetch" href="https://www.googletagmanager.com">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap">

		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">

		<meta name="generator" content={Astro.generator} />

        <meta name="description" content={description}>
        <meta name="author" content={author}>

        <meta property="og:url" content={url}>
        <meta property="og:type" content="website">

        {!!og && 
            <meta property="og:title" content={title}>
            <meta property="og:description" content={description}>
        }

        {og?.img && 
            <meta property="og:image" content={og.img.url}>
        }
        {og?.img?.alt && <meta property="og:image:alt" content={og.img.alt}>}
        {og?.img?.type && <meta property="og:image:type" content={og.img.type}>}
        {og?.img?.width && <meta property="og:image:width" content={og.img.width.toString()}>}
        {og?.img?.height && <meta property="og:image:height" content={og.img.height.toString()}>}

        <!-- Google tag (gtag.js) -->
        {import.meta.env.PROD && (
            <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BLG37NTK4J"></script>
            <script is:inline>
                // @ts-expect-error
                window.dataLayer = window.dataLayer || [];
                // @ts-expect-error
                function gtag(){dataLayer.push(arguments);}
                // @ts-expect-error
                gtag('js', new Date());
                // @ts-expect-error
                gtag('config', 'G-BLG37NTK4J');
            </script>
        )}

        <!-- Naver Search Advisor -->
        {import.meta.env.PROD && (
            <meta name="naver-site-verification" content="6d6d37b7cb8c33fa22601afa3a994e0526b4a43f" />
        )}

        <slot name="extra-head" />

		<title>{title}</title>
	</head>
    <body class="flex min-h-dvh w-full flex-col bg-canvas text-fg">
        <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-canvas">본문 바로가기</a>
        <Header />
        <main id="main" class="flex-1">
            <slot />
        </main>
        <Footer />
	</body>
</html>

<style is:global>
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
    /*
     * 시맨틱 색상 토큰. 값은 GitHub Primer 팔레트에 정렬되어 있어
     * github-markdown-css로 렌더되는 본문과 사이트 크롬이 같은 색 체계를 공유한다.
     * 투명도 수식어(bg-accent-subtle/20)를 쓰려면 RGB 채널값이어야 한다.
     */
    :root {
        --color-canvas: 255 255 255;        /* #ffffff */
        --color-canvas-subtle: 246 248 250; /* #f6f8fa */
        --color-fg: 31 35 40;               /* #1f2328 */
        --color-fg-muted: 89 99 110;        /* #59636e */
        --color-line: 209 217 224;          /* #d1d9e0 */
        --color-accent: 9 105 218;          /* #0969da */
        --color-accent-subtle: 125 211 252; /* #7dd3fc */
    }

    :root.dark {
        --color-canvas: 13 17 23;           /* #0d1117 */
        --color-canvas-subtle: 21 27 35;    /* #151b23 */
        --color-fg: 240 246 252;            /* #f0f6fc */
        --color-fg-muted: 145 152 161;      /* #9198a1 */
        --color-line: 61 68 77;             /* #3d444d */
        --color-accent: 68 147 248;         /* #4493f8 */
        --color-accent-subtle: 31 111 235;  /* #1f6feb */
    }

    /*
     * Tailwind preflight의 기본 테두리색(gray-200)을 토큰으로 되돌린다.
     * Header/Footer/PostCard가 색 없는 border-y, border-t-2, border-b-2를 쓰기 때문에 필요하다.
     */
    *,
    ::before,
    ::after {
        border-color: rgb(var(--color-line));
    }

    /*
     * 한국어는 어절(띄어쓰기) 단위로 끊어야 읽힌다. 기본값(word-break: normal)은
     * CJK를 음절 단위로 아무데서나 끊으므로 keep-all로 막는다.
     * keep-all만 쓰면 긴 어절/URL이 컨테이너를 넘치므로 break-word를 함께 준다.
     */
    body {
        word-break: keep-all;
        overflow-wrap: break-word;
    }

    /* 코드는 식별자 단위로 끊기면 안 되고, 넘치면 가로 스크롤이 정답이다. */
    pre,
    code,
    kbd,
    samp,
    tt {
        word-break: normal;
        overflow-wrap: normal;
    }

    :focus-visible {
        outline: 2px solid rgb(var(--color-accent));
        outline-offset: 2px;
        border-radius: 2px;
    }
}

@layer components {
    /* 읽기 폭. 본문 measure를 지배하므로 lg 이상에서도 넓히지 않는다. */
    .content-container {
        @apply w-full mx-auto md:w-[768px];
    }

    /*
     * 카드 그리드 전용. 컬럼 수가 늘어나는 브레이크포인트마다 컨테이너도 같이 넓혀서
     * 카드 한 장의 폭이 334~388px 밴드 안에 머물게 한다.
     * 기존에는 xl에서 768px 안에 3열이 들어가 카드가 229px까지 줄어들었다.
     */
    .content-container-wide {
        @apply w-full mx-auto md:w-[768px] lg:w-[832px] xl:w-[1216px] 2xl:w-[1440px];
    }
}
</style>
