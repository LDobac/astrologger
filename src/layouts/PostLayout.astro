---
// icons from iconify/fluent
import SeriesLink from "@components/SeriesLink.astro";
import TagList from "@components/TagList.astro";
import { FormattedDate } from "@utils/FormattedDate";
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import { slug as slugger } from "github-slugger";
// -light.css/-dark.css는 변수 없이 리터럴 hex로 평탄화되어 있어 클래스 토글이 불가능하다.
// 변수 기반인 통합 파일을 쓰고, 색상 변수만 markdown-theme.css에서 재정의한다.
import "github-markdown-css/github-markdown.css";
import "@styles/markdown-theme.css";
import { GetPostsBySeries } from "@utils/GetPosts";
import PostList from "@components/PostList.astro";

interface Props {
    post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

const { title, date, editDate, series, tags, og } = post.data;
const { Content } = await render(post);

const neighborPosts: Array<CollectionEntry<"posts">> = [];
if (series) {
    const posts = await GetPostsBySeries(series, true);

    const idx = posts.findIndex((p) => p.id === post.id);
    if (idx > -1) {
        neighborPosts.push(
            ...posts.slice(
                Math.max(idx - 4, 0),
                Math.min(idx + 4, posts.length),
            ),
        );
    }
}
---

<div class="content-container my-6 px-4">
    <header class="flex flex-col space-y-4 border-b-2 pb-6">
        {
            og ? (
                <Image
                    class="max-h-[220px] w-full rounded-xl object-cover bg-black sm:max-h-[280px] md:max-h-[320px]"
                    src={og.img}
                    alt={og.alt}
                    loading="eager"
                    fetchpriority="high"
                />
            ) : (
                <Image
                    class="max-h-[220px] w-full rounded-xl object-cover bg-black sm:max-h-[280px] md:max-h-[320px]"
                    src={`/image/thumbnail/${slugger(title)}.svg`}
                    width={1200}
                    height={630}
                    alt={"Thumbnail of " + title}
                    loading="eager"
                    fetchpriority="high"
                />
            )
        }

        <h1 class="text-2xl font-bold leading-snug md:text-3xl">{title}</h1>
        {!!series && (
            <p class="text-sm text-fg-muted">
                시리즈: <SeriesLink series={series} />
            </p>
        )}

        {!!tags && <TagList tags={tags} />}

        <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-fg-muted">
            <span>
                작성일 <time datetime={date.toISOString()}>{FormattedDate(date)}</time>
            </span>
            {!!editDate && (
                <span>
                    수정일 <time datetime={editDate.toISOString()}>{FormattedDate(editDate)}</time>
                </span>
            )}
        </p>
    </header>

    <article class="mt-6 border-b-2 pb-6">
        <div class="markdown-body prose">
            <Content />
        </div>
    </article>
</div>
{
    series && neighborPosts && (
        <div class="mx-0 my-10 border-y-2 border-line bg-canvas-subtle py-12 xl:mx-20 xl:rounded-2xl xl:border-x-2">
            <h2 class="font-bold text-lg md:text-2xl text-center mb-14 px-4">
                <SeriesLink series={series} />
                <span class="mt-2 block">시리즈의 다른 게시물 보기</span>
            </h2>
            <div class="content-container-wide px-4">
                <PostList posts={neighborPosts} />
            </div>
        </div>
    )
}

<style is:global>
    /* Markdown List Styles */
    .markdown-body ul {
        list-style-type: disc;
    }

    .markdown-body ol ul,
    .markdown-body ul ul {
        list-style-type: circle;
    }

    .markdown-body ol ol ul,
    .markdown-body ol ul ul,
    .markdown-body ul ol ul .markdown-body ul ul ul {
        list-style-type: square;
    }
    .markdown-body ol {
        list-style-type: decimal;
    }

    .markdown-body ol ol,
    .markdown-body ul ol {
        list-style-type: lower-roman;
    }

    .markdown-body ul ul ol,
    .markdown-body ul ol ol,
    .markdown-body ol ul ol,
    .markdown-body ol ol ol {
        list-style-type: lower-alpha;
    }

    .markdown-body figure {
        margin: 0;
    }

    /* Rehype Pretty Code - Code Block */
    pre {
        /*
         * keepBackground이 켜져 있어 shiki가 테마 배경을 직접 넣지만,
         * 코드블록 표면을 시리즈 박스 등 다른 보조 표면과 맞추기 위해 토큰으로 덮는다.
         */
        @apply !px-0 !py-4 !rounded-lg !border !border-line !bg-canvas-subtle;
        /*
         * em으로 두면 .prose의 16/18/20px을 그대로 따라간다.
         * 절대값(!text-sm)을 쓰면 md에서 본문 20px 옆에 코드가 14px로 붙어 버린다.
         */
        @apply !text-[0.9em] !leading-relaxed;
    }

    /* 인라인 코드만. pre 안쪽은 아래에서 따로 다룬다. */
    :not(pre) > code {
        @apply !text-[0.92em] !leading-normal;
    }

    /* 코드블록. 크기는 pre가 정하므로 여기서는 1em으로 상속만 시킨다. */
    pre > code {
        @apply grid !text-[1em];
    }

    /*
     * Rehype Pretty Code - Dual Theme
     * 듀얼 테마에서 shiki는 인라인 color를 넣지 않고 --shiki-light / --shiki-dark 변수만
     * 출력한다(빌드 결과물로 확인). 따라서 라이트·다크 양쪽 모두 여기서 직접 선택해야 하며,
     * 이 블록이 없으면 구문 강조 색이 아예 적용되지 않는다.
     * [data-chars-id]는 자체 라벨 색을 쓰므로 제외한다.
     */
    pre,
    pre span:not([data-chars-id]) {
        color: var(--shiki-light) !important;
    }

    html.dark pre,
    html.dark pre span:not([data-chars-id]) {
        color: var(--shiki-dark) !important;
    }

    /* [data-chars-id] 안쪽 토큰은 shiki 색이 아니라 라벨 색을 물려받아야 한다. */
    pre [data-chars-id] span,
    html.dark pre [data-chars-id] span {
        color: inherit !important;
    }

    /* github-markdown.css의 폰트 스택에는 한글 글리프가 없어 OS 기본 서체로 폴백된다. */
    .markdown-body {
        @apply font-sans;
    }

    /*
     * .markdown-body와 명시도를 맞추기 위해 두 클래스를 함께 쓴다.
     * (둘 다 0,1,0이면 번들 순서에 따라 승패가 갈려 취약하다.)
     * 46rem = 736px = 현재 컨테이너의 실제 콘텐츠 폭. 한글 기준 약 36자/줄.
     */
    .markdown-body.prose {
        @apply max-w-[46rem] sm:text-lg md:text-xl;
        /* github-markdown-css의 1.5는 한글 장문에 너무 빡빡하다. */
        line-height: 1.8;
    }

    /* Rehype Pretty Code - Highlight/Line Numbers */
    [data-line] {
        @apply px-6 border-l-4 border-l-transparent;
    }

    [data-highlighted-line] {
        @apply border-l-accent-subtle bg-accent-subtle/20;
    }

    /* <mark>로 렌더되므로 UA 기본 배경/글자색(노랑/검정)을 덮어야 한다. */
    [data-highlighted-chars] {
        @apply bg-accent-subtle/70 rounded ring-2 ring-accent-subtle;
        box-shadow: 0 0 0 4px rgb(var(--color-accent-subtle) / 0.6);
        color: inherit;
    }

    [data-chars-id] {
        @apply shadow-none p-1 border-b-2;
    }

    [data-chars-id] span {
        @apply !text-inherit;
    }

    /* 라벨 강조 3종. 다크에서는 밝은 배경이 눈부시므로 명암을 뒤집는다. */
    [data-chars-id="v"] {
        @apply !text-rose-700 bg-rose-100 border-b-rose-500 font-bold;
        @apply dark:!text-rose-200 dark:bg-rose-900/60 dark:border-b-rose-400;
        box-shadow: none;
    }

    [data-chars-id="s"] {
        @apply !text-yellow-800 bg-yellow-100 border-b-yellow-600 font-bold;
        @apply dark:!text-yellow-100 dark:bg-yellow-900/60 dark:border-b-yellow-400;
        box-shadow: none;
    }

    [data-chars-id="i"] {
        @apply !text-purple-700 bg-purple-100 border-b-purple-500 font-bold;
        @apply dark:!text-purple-200 dark:bg-purple-900/60 dark:border-b-purple-400;
        box-shadow: none;
    }

    code[data-line-numbers] {
        counter-reset: line;
    }

    code[data-line-numbers] > [data-line]::before {
        counter-increment: line;
        content: counter(line);

        @apply inline-block mr-4 w-8 text-left text-fg-muted;
    }

    code[data-line-numbers-max-digits="2"] > [data-line]::before {
        @apply w-4;
    }

    code[data-line-numbers-max-digits="3"] > [data-line]::before {
        @apply w-8;
    }

    /* Rehype Pretty Code - Title/Caption */
    [data-rehype-pretty-code-fragment] {
        position: relative;
    }

    [data-rehype-pretty-code-fragment] [data-rehype-pretty-code-title] {
        @apply inline rounded-t-lg px-4 py-3 text-sm leading-tight text-accent bg-canvas-subtle;
        font-family:
            ui-monospace,
            SFMono-Regular,
            SF Mono,
            Menlo,
            Consolas,
            Liberation Mono,
            monospace;
    }
</style>
