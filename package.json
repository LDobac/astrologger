{
  "name": "astrologger",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "game:install": "npm --prefix games/LLM_Corpora ci",
    "build": "astro check && tsc --noEmit && astro build",
    "test": "node --test scripts/*.test.mjs",
